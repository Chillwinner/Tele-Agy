# ==========================================
# tele-agy 配置文件示例
# 复制本文件为 .env 并填入真实配置
# ==========================================

# 1. Telegram Bot Token (从 Telegram 找 @BotFather 获得)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. 授权的 Telegram 用户 ID 白名单 (找 @userinfobot 获得你的数字 ID)
# 多个 ID 请用英文逗号分隔，如: 12345678,87654321
ALLOWED_USER_IDS=123456789

# 3. 默认工作区目录 (如果未指定，默认使用当前目录)
DEFAULT_WORKSPACE=/Volumes/Data/machine-setup-workspace/agy

# 4. agy 可执行文件路径 (如在环境变量中保持 agy 即可)
AGY_BIN_PATH=agy

# 5. FastAPI 服务配置 (本地监听端口)
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8080

# 6. SQLite 数据库路径 (存储会话映射与状态)
DATABASE_PATH=tele_agy.db
